# CloudRip API Configuration
# Copy to .env and modify as needed

# Server settings
CLOUDRIP_HOST=127.0.0.1
CLOUDRIP_PORT=8000
CLOUDRIP_RELOAD=false
CLOUDRIP_WORKERS=1

# CORS (comma-separated origins, or * for all)
# Example: http://localhost:3000,https://example.com,https://app.example.com
CLOUDRIP_CORS_ORIGINS=*


# Scanning defaults
CLOUDRIP_DEFAULT_THREADS=10
CLOUDRIP_MAX_THREADS=100
CLOUDRIP_MAX_BATCH_DOMAINS=100

# Remote wordlist settings
CLOUDRIP_MAX_WORDLIST_URLS=5
CLOUDRIP_MAX_WORDLIST_SIZE=10485760
CLOUDRIP_WORDLIST_TIMEOUT=30

# SOCKS Proxy settings (for DNS queries via proxy)
# Comma-separated list of SOCKS proxy URLs
# Format: socks5://host:port or socks5://user:pass@host:port
# Example: socks5://proxy1.com:1080,socks5://user:pass@proxy2.com:1080
CLOUDRIP_PROXIES=
# Enable proxy rotation (cycle through proxies)
CLOUDRIP_PROXY_ROTATE=true
